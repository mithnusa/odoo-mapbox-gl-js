<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <div t-name="base_mapbox_gl_isochrone.GeoJsonIsochroneField">
        <div class="o_mapboxgl_renderer">
            <div
                class="o_mapboxgl_view border rounded-2"
                id="o_mapboxgl_view_widget_geojson_isochrone"
                t-ref="this.mapRef"
            />
            <div class="o_mapboxgl_view_startpoint" t-if="!this.mapboxState.isMapReady">
                <t t-if="this.mapboxState.isCheckingConnection">
                    <i class="oi oi-spin me-2" data-icon="progress_activity" />
                    <span>Checking connection...</span>
                </t>
                <t t-elif="this.mapboxState.isInternetConnected === false">
                    <div class="text-center">
                        <i class="oi text-danger d-block mb-2" data-icon="wifi" style="font-size: 2rem;" />
                        <span class="d-block mb-2">No internet connection</span>
                        <button class="btn btn-sm btn-primary" t-on-click="this.retryConnection">
                            <i class="oi me-1" data-icon="refresh" />
                            Retry
                        </button>
                    </div>
                </t>
                <t t-else="">
                    <i class="oi oi-spin me-2" data-icon="progress_activity" />
                    <span>Loading map...</span>
                </t>
            </div>
            <Search t-if="this.mapboxState.isMapLoaded" />
        </div>
        <div t-if="this.isochroneArea" class="o_mapboxgl_isochrone_area my-1 smaller text-700">
            <p class="mb-0">
                <span>Coverage area:</span>
                <span class="ms-1" t-out="this.isochroneArea.metric" />
                <span class="mx-1">|</span>
                <span t-out="this.isochroneArea.imperial" />
            </p>
            <p class="mb-1" t-if="this.isochroneReach">
                <span>Reaches up to</span>
                <span class="ms-1" t-out="this.isochroneReach.metric" />
                <span class="mx-1">|</span>
                <span t-out="this.isochroneReach.imperial" />
            </p>
        </div>
    </div>
</templates>
