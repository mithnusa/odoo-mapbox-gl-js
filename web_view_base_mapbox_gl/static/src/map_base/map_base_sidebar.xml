<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="web_view_base_mapbox_gl.RecordItem">
        <tr t-attf-class="{{ this.props.allowSelectors &amp;&amp; record.selected ? 'table-info' : '' }}">
            <t t-set="_showMarker" t-value="typeof showMarker === 'boolean' ? showMarker : true" />
            <t t-if="this.props.allowSelectors">
                <td style="width: 20px;">
                    <CheckBox
                        disabled="!this.props.handleCanSelectRecord"
                        value="record.selected"
                        onChange.alike="() => this.selectRecord(record)"
                    />
                </td>
            </t>
            <td class="o_sidebar_content_cell">
                <div class="d-flex gap-2 align-items-center cursor-pointer" t-on-click="() => fnPinPointInMap(record)">
                    <div class="o_map_sidebar_record" t-att-data-tooltip="data.other?.title">
                        <Field id="this.props.title" name="this.props.title" record="record" readonly="true" />
                    </div>
                </div>
            </td>
            <td>
                <div class="d-flex align-items-center justify-content-center">
                    <span class="me-2" t-if="_showMarker">
                        <i class="oi oi-filled" data-icon="circle" t-attf-style="color: #{data?.other?.__geoColor || 'red'};" />
                    </span>
                    <button
                        type="button"
                        class="btn btn-sm btn-link"
                        id="open-record"
                        data-tooltip="Open"
                        t-on-click.prevent="() => fnOpenRecord(record)"
                    >
                        <i class="oi oi-lg" data-icon="keyboard_arrow_right" />
                    </button>
                </div>
            </td>
        </tr>
    </t>
    <t t-name="web_view_base_mapbox_gl.GroupItem">
        <tr>
            <td class="o_sidebar_content_cell" colspan="99">
                <div class="d-flex justify-content-between align-items-center">
                    <button
                        t-attf-class="btn btn-link #{ group.group.records.length ? '' : 'collapsed'}"
                        t-attf-id="btn-group-collapse-#{group.key}"
                        t-att-data-group_id="group.key"
                        type="button"
                        data-bs-toggle="collapse"
                        t-attf-data-bs-target="#collapseGroup_#{ group.key }"
                        aria-expanded="false"
                        t-attf-aria-controls="collapseGroup_#{ group.key }"
                        t-on-click.prevent="(ev) => this.handleGroupCollapse(ev, group.key)"
                    >
                        <div class="d-flex align-items-center o_map_sidebar_group">
                            <t
                                t-set="title"
                                t-value="(group.group.displayName || 'None') + ' (' + group.group.count + ')' "
                            />
                            <span class="me-2">
                                <i class="oi" data-icon="arrow_right" />
                                <i class="oi" data-icon="arrow_drop_down" />
                            </span>
                            <span class="ps-1 pe-1" t-out="title" t-att-data-tooltip="title" />
                        </div>
                    </button>
                    <div t-if="group.group.count">
                        <span class="me-1">
                            <i class="oi oi-filled" data-icon="circle" t-attf-style="color: #{group.group.groupColor || 'red'};" />
                        </span>
                        <button
                            type="button"
                            class="btn btn-sm btn-link"
                            data-tooltip="Open"
                            t-on-click="() => this.actionShowGroupRecords(group)"
                        >
                            <i class="oi oi-lg" data-icon="keyboard_double_arrow_right" />
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="o_sidebar_content_cell" colspan="99" style="padding: 0; border: 0;">
                <div
                    t-attf-class="collapse #{ group.group.records.length ? 'show' : '' }"
                    t-attf-id="collapseGroup_#{ group.key }"
                >
                    <t t-if="group.group.records.length">
                        <table class="table table-sm table-hover mb-0">
                            <tbody>
                                <t t-foreach="group.group.records" t-as="record" t-key="record.id">
                                    <t
                                        t-call="{{ this.constructor.recordItemTemplate }}"
                                        record="record"
                                        data="record.dataView"
                                        showMarker="false"
                                        fnPinPointInMap="fnPinPointInMap"
                                        fnOpenRecord="fnOpenRecord"
                                    />
                                </t>
                                <tr t-if="group.group.count > group.group.records.length">
                                    <td colspan="99">
                                        <div
                                            class="d-flex justify-content-center align-items-center cursor-pointer"
                                            role="button"
                                            t-on-click.prevent="() => this.actionShowGroupRecords(group)"
                                        >
                                            <span class="me-2">see more</span>
                                            <i class="oi oi-lg" data-icon="keyboard_double_arrow_right" />
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </div>
            </td>
        </tr>
    </t>
    <t t-name="web_view_base_mapbox_gl.ListGroupOrRecord">
        <table class="table table-sm table-hover">
            <tbody>
                <t t-if="this.datas.length">
                    <t t-foreach="this.datas" t-as="groupOrRecord" t-key="groupOrRecord.key">
                        <t t-if="groupOrRecord.group">
                            <t
                                t-call="{{ this.constructor.groupItemTemplate }}"
                                group="groupOrRecord"
                                fnPinPointInMap="fnPinPointInMap"
                                fnOpenRecord="fnOpenRecord"
                            />
                        </t>
                        <t t-else="">
                            <t t-set="record" t-value="groupOrRecord.record" />
                            <t
                                t-call="{{ this.constructor.recordItemTemplate }}"
                                record="record"
                                data="record.dataView"
                                fnPinPointInMap="fnPinPointInMap"
                                fnOpenRecord="fnOpenRecord"
                            />
                        </t>
                    </t>
                </t>
                <t t-else="">
                    <tr>
                        <td colspan="99">
                            <div class="d-flex flex-column align-items-center">
                                <h5>No data available to display</h5>
                                <small class="text-muted">Please ensure geolocation data is set</small>
                            </div>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>
    </t>
    <t t-name="web_view_base_mapbox_gl.Sidebar">
        <div class="o_map_sidebar">
            <div class="mt-2 mx-1">
                <div class="d-flex">
                    <t t-if="this.props.allowSelectors">
                        <CheckBox value="this.props.handleSelectAll" onChange.bind="this.props.handleToggleSelection" />
                    </t>
                    <h3 t-if="this.props.header" t-out="this.props.header" />
                    <small class="ms-2 text-muted">
                        <span data-tooltip="Only records with geolocation data set are displayed">
                            <i class="oi" data-icon="info" />
                        </span>
                    </small>
                </div>
            </div>
            <div t-if="(this.props.unLocatedCount || 0) &gt; 0" class="py-1" name="unlocated-records">
                <div class="d-flex align-items-center justify-content-end px-1">
                    <div>
                        <span>Unlocated</span>
                        <span class="ms-1">
                            <span>(</span>
                            <span t-out="this.props.unLocatedCount" />
                            <span>)</span>
                        </span>
                    </div>
                    <button
                        type="button"
                        class="btn btn-link"
                        data-tooltip="Show Unlocated"
                        t-on-click.prevent="() => this.props.showUnlocatedRecords()"
                    >
                        <i class="oi oi-lg" data-icon="keyboard_double_arrow_right" aria-hidden="true" />
                    </button>
                </div>
            </div>
            <t
                t-call="{{ this.constructor.listGroupOrRecordTemplate }}"
                fnPinPointInMap="this.props.pointInMap"
                fnOpenRecord="this.props.showRecord"
            />
        </div>
    </t>
</templates>
