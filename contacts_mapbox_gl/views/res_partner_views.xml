<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_crm_partner_geo_form_inherit_mapbox_gl" model="ir.ui.view">
        <field name="name">view.crm.partner.get.form.inherit.mapbox_gl</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_geolocalize.view_crm_partner_geo_form" />
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='date_localization']/.." position="inside">
                <field name="marker_color" widget="color_picker" />
            </xpath>
        </field>
    </record>
    <record id="view_res_partner_mapbox_gl_geolocate" model="ir.ui.view">
        <field name="name">view.res.partner.mapbox_gl_geolocate</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <mapbox_gl
                string="Contacts"
                enable_clustering="1"
                color_field="marker_color"
                js_class="mapbox_gl_geolocate_contacts"
                lat_field="partner_latitude"
                lng_field="partner_longitude"
                title_field="display_name"
                description_field="contact_address"
                sidebar_avatar="avatar_128"
            >
                <field name="partner_latitude" />
                <field name="partner_longitude" />
                <field name="display_name" />
                <field name="contact_address" />
                <field name="avatar_128" />
                <field name="marker_color" />
            </mapbox_gl>
        </field>
    </record>
    <record id="base.action_partner_form" model="ir.actions.act_window">
        <field
            name="view_mode"
            model="ir.actions.act_window"
            eval="','.join(dict.fromkeys(obj(ref('base.action_partner_form')).view_mode.split(',') + ['mapbox_gl']))"
        />
    </record>
    <record id="contacts.action_contacts" model="ir.actions.act_window">
        <field
            name="view_mode"
            model="ir.actions.act_window"
            eval="','.join(dict.fromkeys(obj(ref('contacts.action_contacts')).view_mode.split(',') + ['mapbox_gl']))"
        />
    </record>
    <record id="action_contacts_view_mapbox_gl" model="ir.actions.act_window.view">
        <field name="sequence" eval="5" />
        <field name="view_mode">mapbox_gl</field>
        <field name="view_id" ref="contacts_mapbox_gl.view_res_partner_mapbox_gl_geolocate" />
        <field name="act_window_id" ref="contacts.action_contacts" />
    </record>
</odoo>
