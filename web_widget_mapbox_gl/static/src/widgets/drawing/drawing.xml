<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <div t-name="web_widget_mapbox_gl.DrawingField">
        <div class="o_mapboxgl_renderer">
            <div class="o_mapboxgl_view border rounded-2" id="o_mapboxgl_view_widget" t-ref="this.mapRef" />
            <div class="o_mapboxgl_view_startpoint" t-if="!this.mapboxState.isMapReady">
                <t t-if="this.mapboxState.isCheckingConnection">
                    <i class="oi oi-spin me-2" data-icon="progress_activity" />
                    <span>Checking connection...</span>
                </t>
                <t t-elif="this.mapboxState.isInternetConnected === false">
                    <div class="text-center">
                        <i class="oi text-danger d-block mb-2" data-icon="wifi" style="font-size: 2rem;" />
                        <span class="d-block mb-2">No internet connection</span>
                        <button class="btn btn-sm btn-primary" t-on-click="this.retryConnection">
                            <i class="oi me-1" data-icon="refresh" />
                            Retry
                        </button>
                    </div>
                </t>
                <t t-else="">
                    <i class="oi oi-spin me-2" data-icon="progress_activity" />
                    <span>Loading map...</span>
                </t>
            </div>
            <Drawing
                readonly="this.props.readonly"
                mapbox="this.mapBoxGlJs"
                dataGeoJson="this.geoJson"
                record="this.props.record"
                saveFeatures.bind="this.handleSave"
                t-if="this.mapboxState.isMapLoaded"
            />
            <Search t-if="this.mapboxState.isMapLoaded" />
        </div>
    </div>
</templates>
