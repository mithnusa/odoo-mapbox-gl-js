<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_route_planner_line_list" model="ir.ui.view">
        <field name="name">view.route.planner.line.list</field>
        <field name="model">route.planner.line</field>
        <field name="arch" type="xml">
            <list
                string="Route Stop"
                decoration-info="state == '01_arrived'"
                decoration-success="state == '04_done'"
                decoration-danger="state == '03_cancell_or_skipped'"
                create="0"
                delete="0"
            >
                <field name="route_planner_id" />
                <field name="stop_sequence" optional="hide" />
                <field name="stop_id" optional="hide" />
                <field name="stop_address" optional="show" />
                <field name="state" />
                <field name="service_duration" widget="float_time" optional="hide" />
                <field name="distance_from_previous" optional="hide" />
                <field name="duration_from_previous" widget="float_time" optional="hide" />
                <field name="attachment_count" optional="show" />
                <field name="company_id" optional="hide" />
                <field name="user_id" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_route_planner_line_form" model="ir.ui.view">
        <field name="name">view.route.planner.line.form</field>
        <field name="model">route.planner.line</field>
        <field name="arch" type="xml">
            <form string="Route Stop">
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="00_none,01_arrived,04_done,03_cancell_or_skipped"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="stop_id" context="{'show_address': 1}" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="Route">
                            <field name="route_planner_id" readonly="1" />
                            <field name="stop_sequence" invisible="1" />
                            <field name="company_id" readonly="1" />
                            <field name="user_id" readonly="1" />
                        </group>
                        <group string="Travel">
                            <field name="distance_from_previous" readonly="1" />
                            <field name="duration_from_previous" widget="float_time" readonly="1" />
                            <field name="service_duration" widget="float_time" />
                        </group>
                    </group>
                    <group>
                        <field name="stop_notes" readonly="state in ['04_done', '03_cancell_or_skipped']" />
                        <field name="notes" readonly="state in ['04_done', '03_cancell_or_skipped']" />
                        <field name="attachment_count" invisible="1" />
                    </group>
                    <notebook>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" readonly="1">
                                <kanban create="0" delete="0" records_draggable="0">
                                    <field name="name" />
                                    <field name="mimetype" />
                                    <templates>
                                        <t t-name="card">
                                            <div
                                                t-if="record.mimetype.raw_value and record.mimetype.raw_value.startsWith('image/')"
                                            >
                                                <img
                                                    t-attf-src="/web/image/ir.attachment/{{ record.id.raw_value }}/datas"
                                                    t-att-alt="record.name.value"
                                                    class="img-fluid rounded"
                                                    style="max-height: 160px; object-fit: contain;"
                                                />
                                                <div class="small text-truncate" t-out="record.name.value" />
                                            </div>
                                            <div t-else="" class="d-flex align-items-center gap-2 p-2 border rounded">
                                                <i
                                                    class="fa fa-file-o fa-2x text-primary"
                                                    t-att-title="record.name.value"
                                                    aria-hidden="true"
                                                />
                                                <div class="text-truncate">
                                                    <div class="fw-bold text-truncate" t-out="record.name.value" />
                                                    <small class="text-muted" t-out="record.mimetype.value" />
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_route_planner_line_search" model="ir.ui.view">
        <field name="name">view.route.planner.line.search</field>
        <field name="model">route.planner.line</field>
        <field name="arch" type="xml">
            <search string="Route Stop">
                <field name="stop_id" />
                <field name="route_planner_id" />
                <field name="stop_address" />
                <separator />
                <filter string="Not Started" name="none" domain="[('state', '=', '00_none')]" />
                <filter string="Arrived" name="arrived" domain="[('state', '=', '01_arrived')]" />
                <filter string="Done" name="done" domain="[('state', '=', '04_done')]" />
                <filter
                    string="Cancelled/Skipped"
                    name="cancelled"
                    domain="[('state', '=', '03_cancell_or_skipped')]"
                />
                <group>
                    <filter string="Route" name="group_route" context="{'group_by': 'route_planner_id'}" />
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_route_planner_line" model="ir.actions.act_window">
        <field name="name">Route Stop</field>
        <field name="res_model">route.planner.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_route_planner_line_search" />
        <field name="context">{'search_default_group_route': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No route stops yet!</p>
            <p>
                Stops are created from within a route — open a Route Planner
                record and add stops there.
            </p>
        </field>
    </record>

    <record id="action_route_planner_line_list" model="ir.actions.act_window.view">
        <field name="view_id" ref="view_route_planner_line_list" />
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="act_window_id" ref="action_route_planner_line" />
    </record>

    <record id="action_route_planner_line_form" model="ir.actions.act_window.view">
        <field name="view_id" ref="view_route_planner_line_form" />
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="act_window_id" ref="action_route_planner_line" />
    </record>
</odoo>
